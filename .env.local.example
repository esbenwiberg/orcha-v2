# Copy to .env and fill in values:
#   cp .env.local.example .env

# REQUIRED — must match your ACA deployment to decrypt credentials/model configs.
# Get it from: az containerapp show -n orcha -g <rg> --query "properties.configuration.secrets[?name=='session-secret'].value" -o tsv
# Or check your infra/parameters.json → sessionSecret
SESSION_SECRET=

# OPTIONAL overrides (defaults shown)
# LOCAL_PORT=3001
# MAX_CONCURRENT_SESSIONS=3
# ACA_MOUNT_PATH=Z:/
