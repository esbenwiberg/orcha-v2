{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccountName": {
      "value": "orchadata<unique>"
    },
    "environmentName": {
      "value": "orcha-env"
    },
    "containerAppName": {
      "value": "orcha"
    },
    "acrName": {
      "value": "orchaacr<unique>"
    },
    "imageTag": {
      "value": "latest"
    },
    "orchaToken": {
      "value": "REPLACE_ME"
    },
    "sessionSecret": {
      "value": "REPLACE_ME"
    },
    "orchaDomain": {
      "value": "orcha.example.com"
    },
    "acmeEmail": {
      "value": "ops@example.com"
    }
  }
}
