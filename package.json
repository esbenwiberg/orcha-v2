{
  "name": "orcha",
  "version": "0.1.0",
  "description": "Terminal session manager",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "devguard": "./bin/devguard.js",
    "devguard-redact-hook": "./bin/devguard-redact-hook.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/web/start-server.ts src/devguard/cli.ts src/devguard/redact-hook.ts --format esm --dts --out-dir dist --external better-sqlite3 --external node-pty --external passport --external openid-client",
    "build:check": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "vendor:assets": "node scripts/vendor-assets.js",
    "postinstall": "node scripts/vendor-assets.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.1",
    "@types/passport": "^1.0.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@xterm/addon-fit": "^0.11.0",
    "eslint": "^9.39.3",
    "eslint-plugin-import": "^2.32.0",
    "htmx-ext-sse": "^2.2.4",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "xterm": "^5.3.0"
  },
  "dependencies": {
    "@azure/arm-authorization": "^9.0.0",
    "@azure/identity": "^4.13.0",
    "@clack/prompts": "^1.0.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/supertest": "^7.2.0",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "eta": "^3.5.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "htmx.org": "2.0.8",
    "js-yaml": "^4.1.1",
    "node-pty": "^1.1.0",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "supertest": "^7.2.2",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  }
}
